{
  "name": "bd-doctors",
  "version": "1.0.0",
  "private": true,
  "description": "ShasthoSheba — directory of Bangladeshi doctors: qualifications, chambers, schedules and contact info",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "deploy": "node scripts/deploy.mjs",
    "seed": "npm --prefix server run seed",
    "install:all": "npm --prefix client install && npm --prefix server install"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "mongoose": "^8.9.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
